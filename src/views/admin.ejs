<%- include('parciales/cabecera') %>
<div class="pagina-form">
  <h1>⚙️ Administración</h1>
  <p class="subtitulo">Usuarios, piezas eliminadas, exportar, respaldar y reiniciar el sitio.</p>

  <nav class="indice-admin" aria-label="Secciones">
    <a href="#usuarios">Usuarios</a> · <a href="#eliminadas">Piezas eliminadas</a> · <a href="#datos">Exportar y respaldar</a> · <a href="#reiniciar">Reiniciar el sitio</a>
  </nav>

  <section class="tarjeta" id="usuarios" aria-labelledby="t-usuarios">
    <h2 id="t-usuarios">👤 Usuarios</h2>
    <% if (errores.usuarios) { %><p class="campo-error-general" role="alert"><%= errores.usuarios %></p><% } %>
    <p class="ayuda">El <strong>registrador</strong> ve, registra, mueve piezas e imprime etiquetas. El <strong>administrador</strong>, además, edita todos los datos, elimina piezas y maneja esta página.
      El documento solo se ve aquí; en el historial aparece el nombre.</p>
    <div class="tabla-envoltura">
    <table class="tabla">
      <thead><tr><th scope="col">Nombre completo</th><th scope="col">Documento</th><th scope="col">Usuario</th><th scope="col">Rol</th><th scope="col">Estado</th><th scope="col"><span class="sr">Acción</span></th></tr></thead>
      <tbody>
        <% for (const u of usuarios) { %>
        <tr class="<%= u.activo ? '' : 'usuario-inactivo' %>">
          <td><%= u.nombre %></td>
          <td class="mono"><%= u.documento || '—' %></td>
          <td class="mono"><%= u.usuario %></td>
          <td><span class="insignia-rol insignia-rol-<%= u.rol %>"><%= nombresRol[u.rol] %></span></td>
          <td><%= u.activo ? 'Activo' : 'Desactivado' %></td>
          <td>
            <% if (u.usuario === usuario.usuario) { %><span class="rotulo">tú</span>
            <% } else { %>
            <form action="/admin/usuarios/<%= u.id %>/<%= u.activo ? 'desactivar' : 'activar' %>" method="post" class="form-en-linea">
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <button type="submit" class="boton-texto <%= u.activo ? 'boton-peligro' : '' %>"><%= u.activo ? 'Desactivar' : 'Reactivar' %></button>
            </form>
            <% } %>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
    </div>

    <h3 class="separado">Nuevo usuario</h3>
    <form action="/admin/usuarios" method="post" class="formulario" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <% if (errores.usuario) { %><p class="campo-error-general" role="alert"><%= errores.usuario %></p><% } %>
      <div class="rejilla-campos">
        <div class="campo">
          <label for="n-nombre">Nombre completo</label>
          <input id="n-nombre" name="nombre" type="text" maxlength="80" required value="<%= nuevo.nombre || '' %>" placeholder="ej.: Ana María Gómez Ruiz" autocomplete="off">
        </div>
        <div class="campo">
          <label for="n-documento">Documento de identidad</label>
          <input id="n-documento" name="documento" type="text" maxlength="20" required inputmode="numeric" value="<%= nuevo.documento || '' %>" placeholder="sin puntos" autocomplete="off">
        </div>
        <div class="campo">
          <label for="n-usuario">Usuario para entrar</label>
          <input id="n-usuario" name="usuario" type="text" maxlength="30" required value="<%= nuevo.usuario || '' %>" placeholder="ej.: aprendiz.ana" autocomplete="off" autocapitalize="none" spellcheck="false">
        </div>
        <div class="campo">
          <label for="n-rol">Rol</label>
          <select id="n-rol" name="rol">
            <option value="editor" <%= nuevo.rol !== 'admin' ? 'selected' : '' %>>Registrador (ve, registra, mueve, etiquetas)</option>
            <option value="admin" <%= nuevo.rol === 'admin' ? 'selected' : '' %>>Administrador (además edita, elimina y maneja usuarios)</option>
          </select>
        </div>
        <div class="campo">
          <label for="n-clave">Contraseña <span class="recomendado">mín. 8</span></label>
          <input id="n-clave" name="contrasena" type="password" minlength="8" required autocomplete="new-password">
        </div>
        <div class="campo">
          <label for="n-repetir">Repite la contraseña</label>
          <input id="n-repetir" name="repetir" type="password" minlength="8" required autocomplete="new-password">
        </div>
      </div>
      <button class="boton" type="submit">Crear usuario</button>
    </form>
  </section>

  <section class="tarjeta" id="eliminadas" aria-labelledby="t-eliminadas">
    <h2 id="t-eliminadas">🗑️ Piezas eliminadas</h2>
    <% if (!eliminadas.length) { %>
    <p class="vacio">No se ha eliminado ninguna pieza.</p>
    <% } else { %>
    <div class="tabla-envoltura">
    <table class="tabla">
      <thead><tr><th scope="col">Pieza</th><th scope="col">Motivo</th><th scope="col">Quién</th><th scope="col">Cuándo</th></tr></thead>
      <tbody>
        <% for (const e of eliminadas) { %>
        <tr><td class="mono"><%= e.pieza_id %><br><small><%= e.categoria %></small></td><td><%= e.motivo %></td><td><%= e.nombre %></td><td><%= e.fecha %></td></tr>
        <% } %>
      </tbody>
    </table>
    </div>
    <% } %>
  </section>

  <section class="tarjeta" id="datos" aria-labelledby="t-datos">
    <h2 id="t-datos">💾 Exportar y respaldar</h2>
    <p>El Excel tiene las columnas de la hoja Inventario, más el panel y el historial de movimientos. Es el <strong>plan B</strong> de la exposición.</p>
    <p class="acciones">
      <a class="boton" href="/exportar.xlsx" download>⬇ Exportar inventario a Excel</a>
      <a class="boton boton-secundario" href="/admin/respaldo" download>⬇ Descargar respaldo de la base</a>
    </p>
    <p class="ayuda">El respaldo es una copia exacta de la base (incluye usuarios con sus contraseñas cifradas): guárdalo en un lugar privado.
      En el VPS, además, se hace un respaldo automático cada noche a las 2:00 a. m. y se guardan 14 días.</p>
  </section>

  <section class="tarjeta zona-peligro" id="reiniciar" aria-labelledby="t-reiniciar">
    <h2 id="t-reiniciar">🔄 Reiniciar el sitio</h2>
    <p>Borra <strong>todos los usuarios</strong> (también el tuyo) y cierra todas las sesiones. El sitio vuelve a la
      <strong>configuración inicial</strong>: al tocar Entrar se pide crear el administrador. Sirve para mostrar ese primer paso en una demostración.</p>
    <p class="ayuda">Antes de borrar se guarda una copia automática de la base en el servidor (carpeta <span class="mono">respaldos</span>).</p>
    <form action="/admin/reiniciar" method="post" class="formulario">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <label class="opcion"><input type="checkbox" name="vaciar_inventario" value="1"> También vaciar el inventario (piezas, historial y eliminadas). Las etiquetas impresas se conservan.</label>
      <div class="campo">
        <label for="confirmar_reinicio">Para confirmar, escribe <strong class="mono"><%= fraseReiniciar %></strong></label>
        <input id="confirmar_reinicio" name="confirmar_reinicio" type="text" autocomplete="off" spellcheck="false" maxlength="30"
          <%- errores.reiniciar ? 'aria-invalid="true" aria-describedby="e-reiniciar"' : '' %>>
        <% if (errores.reiniciar) { %><p class="campo-error" id="e-reiniciar"><%= errores.reiniciar %></p><% } %>
      </div>
      <button class="boton boton-peligro" type="submit">Reiniciar el sitio</button>
    </form>
  </section>
</div>
<%- include('parciales/pie') %>
