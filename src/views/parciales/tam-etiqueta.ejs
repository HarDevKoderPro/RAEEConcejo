<fieldset class="campo campo-tam">
  <legend class="etiqueta-campo">Tamaño</legend>
  <div class="opciones">
    <label class="opcion"><input type="radio" name="<%= nombre %>" value="normal" checked> Normal (6,4 × 3,4 cm)</label>
    <label class="opcion"><input type="radio" name="<%= nombre %>" value="pequena"> Pequeña (2 × 1 cm, para RAM y procesadores)</label>
  </div>
</fieldset>
<fieldset class="campo campo-tam">
  <legend class="etiqueta-campo">Papel</legend>
  <div class="opciones">
    <label class="opcion"><input type="radio" name="papel" value="carta" checked> Carta (21,6 × 27,9 cm)</label>
    <label class="opcion"><input type="radio" name="papel" value="a4"> A4 (21 × 29,7 cm)</label>
  </div>
</fieldset>
