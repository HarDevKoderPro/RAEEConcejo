<form class="tarjeta form-ir" action="/ir" method="get">
  <label for="ir-id">Ver la ficha de otra pieza</label>
  <div class="fila-campo">
    <input id="ir-id" name="id" type="text" inputmode="text" autocomplete="off" autocapitalize="characters"
           placeholder="RAEE-0001" required maxlength="120">
    <button class="boton" type="submit">Ver ficha</button>
  </div>
</form>
