<!DOCTYPE html>
<html lang="es-CO">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#12403c">
  <title><%= titulo %> · Inventario RAEE</title>
  <link rel="icon" href="/img/icono.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body class="<%= modoKiosco ? 'kiosco' : '' %>">
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <% if (avisoDemo) { %>
  <div class="aviso-demo" role="note">Incluye datos de demostración</div>
  <% } %>
  <header class="barra">
    <div class="barra-interior">
      <a class="marca" href="/">
        <span class="marca-icono" aria-hidden="true">♻</span>
        <span class="marca-texto">Inventario RAEE<small>Sala de Sistemas</small></span>
      </a>
      <nav aria-label="Principal">
        <a href="/" <%- rutaActual === '/' ? 'aria-current="page"' : '' %>>Inicio</a>
        <a href="/consulta" <%- rutaActual === '/consulta' ? 'aria-current="page"' : '' %>>Consultar</a>
        <a href="/buscar" <%- rutaActual === '/buscar' ? 'aria-current="page"' : '' %>>Buscar</a>
        <a href="/ubicaciones" <%- rutaActual.startsWith('/ubicaciones') ? 'aria-current="page"' : '' %>>Mapa</a>
      </nav>
    </div>
  </header>
  <main id="contenido" class="contenedor">
