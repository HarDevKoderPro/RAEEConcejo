<%- include('parciales/cabecera') %>
<p id="aviso-actualizada" class="aviso aviso-ok aviso-flotante" role="status" hidden>✔ Esta ficha se acaba de actualizar</p>
<article class="ficha" aria-labelledby="ficha-id" data-pieza="<%= pieza.id %>">
  <header class="tarjeta ficha-cabecera">
    <div class="ficha-icono" aria-hidden="true"><%= pieza.icono %></div>
    <div class="ficha-titulos">
      <p class="ficha-categoria"><%= pieza.categoria %></p>
      <h1 id="ficha-id" class="ficha-id"><%= pieza.id %></h1>
      <% if (pieza.demo) { %><span class="etiqueta-demo">dato de demostración</span><% } %>
    </div>
  </header>

  <% if (usuario) { %>
  <nav class="acciones-editor" aria-label="Acciones del editor">
    <a class="boton" href="/movimiento?id=<%= pieza.id %>">⚡ Movimiento rápido</a>
    <a class="boton boton-secundario" href="/p/<%= pieza.id %>/editar">✏️ Editar todo</a>
    <a class="boton boton-secundario" href="/etiquetas/hoja?ids=<%= pieza.id %>">🏷️ Imprimir etiqueta</a>
  </nav>
  <% if (etiqueta && etiqueta.formato === 'ID') { %>
  <p class="aviso aviso-info">🏷️ Su etiqueta es del lote antiguo (solo texto). Conviene reimprimirla con enlace para que cualquier celular abra esta ficha. <a href="/etiquetas/hoja?ids=<%= pieza.id %>">Reimprimir etiqueta</a></p>
  <% } %>
  <% } %>

  <section class="tarjeta ubicacion-destacada" aria-label="Ubicación" data-vivo="ubicacion">
    <span class="ubicacion-icono" aria-hidden="true">📍</span>
    <div>
      <p class="rotulo">Dónde está</p>
      <% if (pieza.ubicacion) { %>
        <p class="ubicacion-nombre"><%= pieza.ubicacion_nombre %></p>
        <p class="ubicacion-codigo">Código <%= pieza.ubicacion %></p>
        <a class="enlace-mapa" href="/ubicaciones?resaltar=<%= pieza.id %>">Ver en el mapa →</a>
      <% } else { %>
        <p class="ubicacion-nombre">Sin ubicación asignada</p>
      <% } %>
    </div>
  </section>

  <div class="insignias">
    <span class="insignia estado-<%= pieza.clase_estado %>" data-vivo="estado"><span class="insignia-rotulo">Estado</span> <%= pieza.estado %></span>
    <span class="insignia destino-<%= pieza.clase_destino %>" data-vivo="destino"><span class="insignia-rotulo">Destino</span> <%= pieza.destino %></span>
  </div>

  <p class="impacto impacto-<%= pieza.clase_destino %>" data-vivo="impacto">
    <span aria-hidden="true"><%= pieza.impacto.icono %></span> <%= pieza.impacto.texto %>
  </p>

  <% if (pieza.foto) { %>
  <figure class="tarjeta ficha-foto">
    <img src="/fotos/<%= pieza.foto %>" alt="Foto de <%= pieza.id %> (<%= pieza.categoria %>)" loading="lazy">
  </figure>
  <% } %>

  <section class="tarjeta" aria-labelledby="t-datos">
    <h2 id="t-datos">Datos de la pieza</h2>
    <dl class="datos">
      <div><dt>Marca</dt><dd><%= pieza.marca || 'Sin registrar' %></dd></div>
      <div><dt>Modelo / P/N</dt><dd><%= pieza.modelo_pn || 'Sin registrar' %></dd></div>
      <div><dt>Serial</dt><dd class="mono"><%= pieza.serial || 'Sin registrar' %></dd></div>
      <div><dt>Peso</dt><dd><%= pieza.peso_texto %> <span class="nota-peso">(<%= pieza.peso_origen %>)</span></dd></div>
      <div class="ancho"><dt>Descripción</dt><dd><%= pieza.descripcion || 'Sin descripción' %></dd></div>
      <% if (pieza.equipo_destino) { %>
      <div><dt>Equipo de destino</dt><dd><%= pieza.equipo_destino %></dd></div>
      <% } %>
      <div><dt>Ingreso</dt><dd><%= pieza.fecha_ingreso_texto %></dd></div>
    </dl>
    <% if (pieza.requiere_borrado) { %>
      <% if (pieza.borrado_seguro === 'Sí') { %>
      <p class="borrado borrado-si" data-vivo="borrado"><span aria-hidden="true">🔒</span> <strong>Borrado seguro realizado.</strong> La información del disco ya se eliminó.</p>
      <% } else { %>
      <p class="borrado borrado-no" data-vivo="borrado"><span aria-hidden="true">⚠️</span> <strong>Borrado seguro pendiente.</strong> Este disco no puede donarse, reutilizarse ni entregarse a reciclaje hasta borrarlo.</p>
      <% } %>
    <% } %>
    <% if (usuario && pieza.notas) { %>
    <div class="notas-internas"><p class="rotulo">Notas internas (solo editores)</p><p><%= pieza.notas %></p></div>
    <% } %>
  </section>

  <section class="tarjeta" aria-labelledby="t-historial">
    <h2 id="t-historial">Historial</h2>
    <% if (historial.length === 0) { %>
      <p class="vacio">Todavía no hay movimientos registrados.</p>
    <% } else { %>
    <ol class="linea-tiempo" data-vivo="historial">
      <% for (const m of historial) { %>
      <li class="hito hito-<%= m.tipo %>">
        <span class="hito-icono" aria-hidden="true"><%= m.icono %></span>
        <div class="hito-cuerpo">
          <p class="hito-titulo"><%= m.titulo %></p>
          <p class="hito-detalle">
            <% if (m.tipo === 'borrado_seguro' && m.valor_nuevo === 'Sí') { %>Información eliminada y verificada
            <% } else if (m.valor_anterior) { %><%= m.valor_anterior %> <span aria-label="cambió a">→</span> <strong><%= m.valor_nuevo %></strong>
            <% } else { %><%= m.valor_nuevo %><% } %>
          </p>
          <time class="hito-fecha" datetime="<%= m.fecha.replace(' ', 'T') %>"><%= m.fecha_texto %></time><% if (m.usuario) { %><span class="hito-usuario"> · 👤 <%= m.usuario %></span><% } %>
          <% if (m.nota) { %><p class="hito-nota"><%= m.nota %></p><% } %>
        </div>
      </li>
      <% } %>
    </ol>
    <% } %>
  </section>

  <p class="ficha-pie">Última actualización: <%= pieza.actualizado_texto %></p>
</article>
<% scripts.push('/js/ficha.js') %>
<%- include('parciales/pie') %>
