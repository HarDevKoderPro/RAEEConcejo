<%- include('parciales/cabecera') %>
<section class="portada">
  <p class="portada-sobretitulo">Sala de Sistemas · SENA</p>
  <h1>Cada pieza con nombre, lugar y destino</h1>
  <p class="portada-texto">
    Las piezas de computador en desuso tienen una etiqueta con código QR. Al escanearla se ve
    qué pieza es, dónde está guardada y qué pasó con ella: si volvió a funcionar en un equipo de
    la sala, si se donó o si va a reciclaje.
  </p>
  <div class="acciones">
    <a class="boton boton-grande" href="/consulta">Consultar por escaneo</a>
    <a class="boton boton-grande boton-secundario" href="/buscar">Buscar piezas</a>
    <a class="boton boton-grande boton-secundario" href="/ubicaciones">Mapa de la sala</a>
  </div>
</section>

<%- include('parciales/buscar-id') %>

<% if (ejemplos.length) { %>
<section aria-labelledby="t-ejemplos">
  <h2 id="t-ejemplos">Fichas de ejemplo</h2>
  <ul class="rejilla-ejemplos">
    <% for (const p of ejemplos) { %>
    <li>
      <a class="tarjeta tarjeta-enlace" href="/p/<%= p.id %>">
        <span class="ejemplo-icono" aria-hidden="true"><%= p.icono %></span>
        <span><strong class="mono"><%= p.id %></strong><br><%= p.categoria %><br>
          <small><%= p.ubicacion_nombre || 'Sin ubicación' %></small></span>
      </a>
    </li>
    <% } %>
  </ul>
</section>
<% } %>
<%- include('parciales/pie') %>
